text = input("Write/paste your text: ").lower()


letters = 0
others = 0

arrayTextPercentages = []
languageDifferences = []

for letter in text:
     if letter.isalpha():
         letters += 1
     if letter.isalpha() and letter not in alphabet:
         others += 1

for letter in alphabet:
    #print(letter, text.count(letter))
    percentage = (text.count(letter) * 100) / letters 
    arrayTextPercentages.append(percentage)
    #print(letter,round(percentage, 2))



for language in languages:
    totalDifference = 0
    for letterIndex in range(len(alphabet)):
        difference = abs(
        arrayTextPercentages[letterIndex] - language[letterIndex]
    )
        totalDifference += difference
        #print("ADDING:", difference, "TOTAL:", totalDifference)

    languageDifferences.append(totalDifference)

#print(languageDifferences)
    #print(difference)


smallestDifference = min(languageDifferences)
languageIndex = languageDifferences.index(smallestDifference)

